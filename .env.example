# Copy to .env.local and fill with your own values (never commit .env.local)
DATABASE_URL="postgresql://kassenbuch:kassenbuch@localhost:5433/kassenbuch_local"
# Railway (prod) nutzt eine Reference-Variable statt eines festen Werts:
# DATABASE_URL="${{Postgres.DATABASE_URL}}"

# Solo-Login (kein Multi-Tenant, ein Account: Konrad).
AUTH_SECRET="change-me-to-a-long-random-string"
# Der Token, den man auf /login eingibt, um die Session zu starten.
LOGIN_TOKEN="change-me-to-a-long-random-string"

# Bearer-Token, mit dem andere Apps (Doewe, Knips, ...) Kosten-/Einnahmen-Events
# gegen /api/webhooks/* pushen. Analog zu Doewes DOEWE_SERVICE_TOKEN-Pattern.
KASSENBUCH_SERVICE_TOKEN="change-me-to-a-long-random-string"
# Bearer-Token fuer GET /api/cron/railway-costs, getriggert von
# .github/workflows/cron-railway-costs.yml.
CRON_SECRET="change-me-to-a-long-random-string"

# Optional: aktiviert automatische Kategorisierung eingehender Buchungen per
# Claude. Ohne Key faellt die Kategorisierung auf "unkategorisiert" zurueck
# (Stub-Verhalten wie Doewes receipt-scan-Route).
ANTHROPIC_API_KEY=""

# Optional (beide zusammen): liest bezahlte Railway-Rechnungen per Public
# API fuer die Hosting-Kosten-Uebersicht. Ohne beide bleibt dieser
# Datenpunkt leer. RAILWAY_API_TOKEN ist ein Account-Token (railway.app ->
# Account Settings -> Tokens, oder per apiTokenCreate-Mutation). Account-
# Tokens koennen "me" nicht abfragen - RAILWAY_WORKSPACE_ID (railway status
# --json -> workspaceId) ist deshalb zwingend fuer den
# workspace(workspaceId:)-Query-Pfad.
RAILWAY_API_TOKEN=""
RAILWAY_WORKSPACE_ID=""

# Ablage fuer hochgeladene Belege. Lokal ein Ordner im Repo, in Prod ein
# Railway Volume (siehe lib/storage.ts).
ATTACHMENTS_DIR="./data/uploads"
