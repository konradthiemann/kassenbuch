# Copy to .env.local and fill with your own values (never commit .env.local)
DATABASE_URL="postgresql://kassenbuch:kassenbuch@localhost:5433/kassenbuch_local"
# Railway (prod) nutzt Reference-Variablen statt fester Werte:
# DATABASE_URL="postgresql://${{PGUSER}}:${{POSTGRES_PASSWORD}}@${{RAILWAY_PRIVATE_DOMAIN}}:5432/${{PGDATABASE}}"

# Solo-Login (kein Multi-Tenant, ein Account: Konrad)
AUTH_SECRET="change-me-to-a-long-random-string"

# Bearer-Token, mit dem andere Apps (Doewe, Knips, ...) Kosten-/Einnahmen-Events
# gegen /api/webhooks/* pushen. Analog zu Doewes DOEWE_SERVICE_TOKEN-Pattern.
KASSENBUCH_SERVICE_TOKEN="change-me-to-a-long-random-string"

# Optional: aktiviert automatische Kategorisierung eingehender Buchungen per
# Claude. Ohne Key faellt die Kategorisierung auf manuelle Zuordnung zurueck
# (Stub-Verhalten wie Doewes receipt-scan-Route).
ANTHROPIC_API_KEY=""

# Optional: liest Railway-Projektkosten per Public API fuer die
# Hosting-Kosten-Uebersicht. Ohne Token bleibt dieser Datenpunkt leer.
RAILWAY_API_TOKEN=""

# Ablage fuer hochgeladene Belege. Lokal ein Ordner im Repo, in Prod ein
# Railway Volume (siehe lib/storage.ts).
ATTACHMENTS_DIR="./data/uploads"
