{
  "name": "kassenbuch",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:push": "dotenv -e .env.local -- sh -c \"prisma generate && prisma db push\"",
    "db:migrate:dev": "dotenv -e .env.local -- prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "dotenv -e .env.local -- tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@prisma/client": "5.19.1",
    "next": "^14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "20.14.11",
    "@types/react": "18.3.5",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "autoprefixer": "10.4.20",
    "dotenv": "^16.4.5",
    "dotenv-cli": "^7.4.2",
    "eslint": "8.57.0",
    "eslint-config-next": "^14.2.35",
    "postcss": "8.4.41",
    "prisma": "5.19.1",
    "tailwindcss": "3.4.10",
    "tsx": "^4.19.0",
    "typescript": "5.5.4",
    "vitest": "1.6.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
